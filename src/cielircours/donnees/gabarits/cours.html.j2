<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<title>{{ cours.titre }}</title>
<link rel="stylesheet" href="{{ feuille }}">
</head>
<body class="mode-{{ mode.value }}">

<div class="entete"><span class="entete-gauche">{{ cours.sequence }}</span><span class="entete-droit">{{ cours.titre }}</span></div>
<div class="pied-gauche">{{ cours.discipline }} – {{ cours.classe }}</div>
<div class="pied-droit">{{ cours.etablissement }} · {{ licence }}</div>

<header class="cartouche">
  <div class="cartouche-ligne">
    <h1 class="titre">{{ cours.titre }}</h1>
    <span class="matiere">{{ cours.discipline }} – {{ cours.classe }}</span>
  </div>
  <div class="cartouche-ligne">
    <span class="type">{{ type_document }}</span>
    <span class="sequence">{{ cours.sequence }}</span>
    <span class="etablissement">{{ cours.etablissement }}</span>
    <span class="meta">
      {%- if cours.duree %}<span class="duree">{{ cours.duree }}</span> {% endif -%}
      <span class="version">{{ pub.libelle }}</span>
    </span>
  </div>
</header>

{% if cours.capacites %}
<section class="capacites">
  <h2>Capacités attendues</h2>
  <ul>
  {% for c in cours.capacites %}
    <li>{{ c }}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}

<main class="corps">
{{ corps | safe }}
</main>

<footer class="licence">
  Ce document est publié sous licence {{ licence }}.
</footer>

</body>
</html>
