<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ cours.titre_page }} · fiche de cours</title>
<link rel="stylesheet" href="{{ feuille }}">
</head>
<body class="fiche">
<div class="page">

<header class="entete-page">
  <nav class="navigation" aria-label="Navigation">
    <a href="{{ accueil }}">← Accueil du cours</a>
    <a href="{{ diaporama }}">Le diaporama</a>
  </nav>
  <h1>{{ cours.titre_page }}</h1>
  <p class="sous-titre">{{ cours.discipline }} — {{ cours.classe }}</p>
  <p class="etablissement">{{ cours.etablissement }}</p>
  <p class="release">{{ pub.release }}</p>
</header>

{% if cours.capacites %}
<section class="capacites">
  <h2>Capacités attendues</h2>
  <ul>
  {% for c in cours.capacites %}
    <li>{{ c }}</li>
  {% endfor %}
  </ul>
</section>
{% endif %}

{% if sommaire %}
<nav class="sommaire" aria-label="Sommaire">
  <h2>Sommaire</h2>
  <ol>
  {% for ancre, intitule in sommaire %}
    <li><a href="#{{ ancre }}">{{ intitule }}</a></li>
  {% endfor %}
  </ol>
</nav>
{% endif %}

<main class="corps">
{{ corps | safe }}
</main>

<footer class="pied-page">
  <p>{{ cours.auteur }}</p>
  <p><a href="{{ url_depot }}">{{ url_depot }}</a></p>
</footer>

</div>
</body>
</html>
